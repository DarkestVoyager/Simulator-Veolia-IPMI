{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: build project",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-Wall", "-Wextra",
                "-IHeaders",
                "Source/*.cpp",
                "-o",
                "${workspaceFolder}\\Source\\build\\Debug\\SimEcoSolar.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds all .cpp files in Source/."
        }
    ],
    "version": "2.0.0"
}